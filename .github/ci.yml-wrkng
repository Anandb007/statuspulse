name: StatusPulse CI

on:
  push:
    branches: ["main"]
  pull_request:
    branches: ["main"]

jobs:
  ci:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      # -------------------------
      # Python Lint (Ruff)
      # -------------------------
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Ruff
        run: pip install ruff

      - name: Lint Code
        run: ruff check app/

      # -------------------------
      # Dockerfile Lint
      # -------------------------
      - name: Hadolint
        uses: hadolint/hadolint-action@v3.1.0
        with:
          dockerfile: Dockerfile
          config: .hadolint.yaml  #newl added
          failure-threshold: warning  #newladded
      # -------------------------
      # Start Stack (NO .env FILE)
      # -------------------------
      - name: Start Docker Stack
        env:
          DB_PASSWORD: ${{ secrets.DB_PASSWORD }}
        run: |
          export DB_PASSWORD=${DB_PASSWORD}   #newlyadded
          docker compose down -v || true
          DB_PASSWORD=$DB_PASSWORD docker compose up -d --build

      - name: Wait for services
        run: sleep 20

      # -------------------------
      # Install tools
      # -------------------------
      - name: Install jq
        run: sudo apt-get update && sudo apt-get install -y jq

      # -------------------------
      # Run Integration Tests
      # -------------------------
      - name: Run Tests
        run: |
          chmod +x tests/test_integration.sh
          ./tests/test_integration.sh

      # -------------------------
      # Logs (always)
      # -------------------------
      - name: Collect Logs
        if: always()
        run: docker compose logs > logs.txt

      - name: Upload Logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ci-logs
          path: logs.txt
